import DataStructures.PerfectHash.Certified

namespace PerfectHash.Export
open WordRam

/-- Render a register with an explicit finite bound proof; no overloaded finite
numeral instance is needed by the exported executable definition. -/
def register (r : Reg 64) : String := "⟨" ++ toString r.val ++ ", by decide⟩"

def operand : Operand 64 → String
  | .reg r => "(.reg " ++ register r ++ ")"
  | .imm n => "(.imm " ++ toString n ++ ")"

def comparison : Comparison → String
  | .eq => ".eq"
  | .ne => ".ne"
  | .lt => ".lt"
  | .le => ".le"

/-- Serialize an instruction as ordinary Lean constructor syntax. -/
def instruction : Instr 64 → String
  | .mov d x => ".mov " ++ register d ++ " " ++ operand x
  | .add d x y => ".add " ++ register d ++ " " ++ operand x ++ " " ++ operand y
  | .sub d x y => ".sub " ++ register d ++ " " ++ operand x ++ " " ++ operand y
  | .mul d x y => ".mul " ++ register d ++ " " ++ operand x ++ " " ++ operand y
  | .mod d x y => ".mod " ++ register d ++ " " ++ operand x ++ " " ++ operand y
  | .shr d x y => ".shr " ++ register d ++ " " ++ operand x ++ " " ++ operand y
  | .load d a => ".load " ++ register d ++ " " ++ operand a
  | .store a x => ".store " ++ operand a ++ " " ++ operand x
  | .rload d a => ".rload " ++ register d ++ " " ++ operand a
  | .branch c x y target => ".branch " ++ comparison c ++ " " ++ operand x ++ " " ++ operand y ++ " " ++ toString target
  | .jump target => ".jump " ++ toString target
  | .call link target => ".call " ++ register link ++ " " ++ toString target
  | .jumpReg target => ".jumpReg " ++ operand target
  | .halt => ".halt"

def program (p : Program 64) : String :=
  "#[\n  " ++ String.intercalate ",\n  " (p.toList.map instruction) ++ "]"

/-- The serialized artifact contains literal arrays and kernel-checkable equality
proofs tying the parsed source back to exactly the certified program values. -/
def source : String :=
  "-- Generated by PerfectHash.Export.source. Regenerate before editing.\n" ++
  "import DataStructures.PerfectHash.Certified\n\n" ++
  "namespace PerfectHash.Exported\n" ++
  "set_option maxRecDepth 50000\nset_option maxHeartbeats 20000000\n\n" ++
  "def preprocess : WordRam.Program 64 := " ++ program fksCode.preprocess ++ "\n\n" ++
  "def query : WordRam.Program 64 := " ++ program fksCode.query ++ "\n\n" ++
  "theorem preprocess_roundtrip : preprocess = PerfectHash.fksCode.preprocess := by decide\n\n" ++
  "theorem query_roundtrip : query = PerfectHash.fksCode.query := by decide\n\n" ++
  "end PerfectHash.Exported\n"

/-- Write the deterministic source artifact into an existing directory; checking
it with Lean validates both serialization round trips against the certified arrays. -/
def write (path : System.FilePath) : IO Unit := do
  IO.FS.writeFile path source
  IO.println ("Exported " ++ path.toString)

end PerfectHash.Export
